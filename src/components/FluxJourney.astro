---
import chapters from '../../content/papers/flux-kontext/visual-journey.json';
import RectifiedFlowLab from './RectifiedFlowLab.astro';
import '../styles/visual-learning.css';
---
<div class="visual-journey" id="visual-guide">
  <header class="journey-intro">
    <p class="eyebrow">The illustrated route · six ideas</p>
    <h2>See it first.<br /><em>Then follow the math.</em></h2>
    <p>Read each picture, try a prediction, and uncover the explanation. Spend extra time in the rectified-flow lab: you can move the mixture, average arrows, and watch noise turn into a toy distribution.</p>
    <div class="journey-actions"><a class="button primary" href="#rectified-flow-lab">Take me to rectified flow ↓</a><a class="button secondary" href="#full-paper-notes">Go to the detailed notes</a></div>
  </header>
  <nav class="chapter-map" aria-label="Visual learning chapters">
    {chapters.map(c=><a href={`#${c.id}`}><span>{c.number}</span><strong>{c.navTitle}</strong></a>)}
  </nav>
  {chapters.map(c=><>
    <section class="visual-chapter" id={c.id} data-visual-chapter aria-labelledby={`${c.id}-title`}>
      <header class="chapter-heading"><span class="chapter-index" aria-hidden="true">{c.number}</span><div><p class="eyebrow">{c.kicker}</p><h2 id={`${c.id}-title`}>{c.title}</h2></div></header>
      <figure class="teaching-figure">
        <button class="image-expand" type="button" data-enlarge-image={`/figures/flux/${c.image}.png`} data-image-alt={c.alt} data-image-caption={c.caption} aria-label={`Enlarge illustration: ${c.title}`}><img src={`/figures/flux/${c.image}.png`} alt={c.alt} loading="lazy" decoding="async" /><span>Enlarge ↗</span></button>
        <figcaption>{c.caption}</figcaption>
      </figure>
      <div class="chapter-explanation"><p>{c.body}</p><div class="remember"><span>Keep this idea</span><strong>{c.takeaway}</strong></div></div>
      <details class="predict"><summary><span>Pause & predict</span>{c.question}<span class="reveal-cue">Think, then reveal +</span></summary><p>{c.answer}</p></details>
      {c.id==='see-training' && <div class="equation-ribbon" aria-label="Interpolation equation"><span class="equation-symbol">zₜ</span><span>=</span><span><b>(1 − t) x</b><small>clean target contribution</small></span><span>+</span><span><b>t ε</b><small>noise contribution</small></span></div>}
      {c.id==='see-context' && <div class="role-comparison"><div><span class="eyebrow">Reference identity</span><strong>(1, h, w)</strong><p>Which image do these tokens belong to?</p></div><div><span class="eyebrow">Flow time</span><strong>t ∈ [0, 1]</strong><p>Where is the target along the noise–data path?</p></div></div>}
      <a class="chapter-source" href={`/papers/flux-kontext.pdf#page=${c.page}`}>Check the paper: {c.source} ↗</a>
    </section>
    {c.id==='see-field' && <RectifiedFlowLab />}
  </>)}
  <section class="journey-finish"><p class="eyebrow">Put the pieces together</p><h2>A reference to consult.<br />A field to follow.</h2><p>Kontext learns how to move a noisy target under image and text conditioning. The reference stays fixed; predictions change with the target and time. Distillation helps make the process fast, while preservation still has to be checked.</p><a class="button primary" href="#study-cards">Test the ideas →</a><a class="button secondary" href="#full-paper-notes">Read the full explanation ↓</a></section>
</div>
<dialog class="image-dialog" aria-label="Expanded teaching illustration"><div class="dialog-toolbar"><span>Teaching illustration · not a model result</span><form method="dialog"><button type="submit" class="button secondary" autofocus>Close ×</button></form></div><img data-dialog-image alt="" /><p data-dialog-caption></p></dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('.image-dialog');
if(dialog){
 const img=dialog.querySelector<HTMLImageElement>('[data-dialog-image]')!;
 document.querySelectorAll<HTMLButtonElement>('[data-enlarge-image]').forEach(button=>button.addEventListener('click',()=>{
  img.src=button.dataset.enlargeImage!;img.alt=button.dataset.imageAlt!;
  dialog.querySelector('[data-dialog-caption]')!.textContent=button.dataset.imageCaption!;
  dialog.showModal();
 }));
 dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
}
// A direct link to a technical heading must also open the surrounding notes.
function revealLinkedNotes(){
 const hash=decodeURIComponent(location.hash.slice(1));if(!hash)return;
 const target=document.getElementById(hash);const parent=target?.closest<HTMLDetailsElement>('details.full-notes');
 if(parent&&!parent.open){parent.open=true;requestAnimationFrame(()=>target?.scrollIntoView());}
}
window.addEventListener('hashchange',revealLinkedNotes);revealLinkedNotes();
</script>
