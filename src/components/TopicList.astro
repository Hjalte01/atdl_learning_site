---
import { getMaterialsWithProgress } from "../lib/materials";
import { topicHref, topicSlug, type Topic } from "../lib/topics";

interface Props {
  topics: Topic[];
  activeSlug?: string;
  compact?: boolean;
}

const materials = await getMaterialsWithProgress();
const { topics, activeSlug, compact = false } = Astro.props;
---

<ol class:list={["topic-list", { compact }]}>
  {topics.map((topic) => {
    const papers = materials.filter(m => m.topic === topic.data.order && m.kind === "paper");
    const ready = papers.filter(m => m.ready).length;
    return (
    <li>
      <a
        href={topicHref(topic)}
        class:list={{ active: topicSlug(topic) === activeSlug }}
        aria-current={topicSlug(topic) === activeSlug ? "page" : undefined}
      >
        <span class="topic-number">{String(topic.data.order).padStart(2, "0")}</span>
        <span class="topic-link-copy">
          <strong>{topic.data.shortTitle}</strong>
          {!compact && <span>{papers.length ? `${ready} ready · ${papers.length - ready} missing · ${papers.length} paper guides` : "No papers supplied"}</span>}
        </span>
        {!compact && <span aria-hidden="true">→</span>}
      </a>
    </li>
  );})}
</ol>
