---
import { withBase } from "../../lib/url";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import StudyDeck from "../../components/StudyDeck.astro";
import DiffAtlasLab from "../../components/DiffAtlasLab.astro";
import FlowExplorer from "../../components/FlowExplorer.astro";
import FluxJourney from "../../components/FluxJourney.astro";
import chapters from "../../../content/papers/flux-kontext/visual-journey.json";
import { getStudyCards } from "../../lib/study";
export async function getStaticPaths() {
 return (await getCollection("papers")).map(paper => ({params:{slug:paper.id.replace(/\/index$/,"")},props:{paper}}));
}
const {paper}=Astro.props;
const isGeneral = paper.data.topic === "general";
const isDiffAtlas=paper.id.replace(/\/index$/, "") === "t2-paper-4";
const isFlux=paper.id.replace(/\/index$/, "") === "flux-kontext";
const {Content, headings}=await render(paper);
const cards=(await getStudyCards()).filter(c=>c.relatedTopicUrl?.startsWith(`/papers/${paper.id.replace(/\/index$/,"")}`));
---
<BaseLayout title={paper.data.shortTitle} description={paper.data.description}>
 <div class:list={["topic-layout", {"flux-page":isFlux}]}><main class="topic-main">
 <a class="back-link" href={withBase(isGeneral ? "/materials" : `/topics/${paper.data.topic}`)}>← {isGeneral ? "Back to reading library" : "Back to topic"}</a>
 <header class="topic-header">
 <p class="eyebrow">{isGeneral ? 'General course material' : `Topic ${paper.data.topic.replace('topic-','')}`} · {paper.data.materialKind === 'paper' ? `Paper ${paper.data.order}` : ({overview: 'Overview', slides: 'Slides', extra: 'Extra material'}[paper.data.materialKind])} · {paper.data.status === 'ready' ? 'Learning guide' : 'Awaiting explanation'}</p>
 <h1>{paper.data.shortTitle}</h1><p class="lede">{paper.data.title}</p><p>{paper.data.description}</p>
 {paper.data.pdf && <a class="button secondary" href={withBase(paper.data.pdf)}>Open the course PDF ↗</a>}
 {paper.data.source && <a class="text-link" href={paper.data.source}>Original paper ↗</a>}
 </header>
 {isFlux ? <>
 <FluxJourney />
 <details class="full-notes" id="full-paper-notes"><summary>The complete paper explanation<span>Equations, architecture, evidence, limitations, and the source-by-source reading map.</span></summary><article class="prose"><Content /></article><FlowExplorer /></details>
 </> : <article class="prose"><Content /></article>}
 {isDiffAtlas && <DiffAtlasLab />}
 <StudyDeck {cards} />
 </main><aside class="toc-sidebar"><TableOfContents headings={[...(isFlux ? [{depth:2,slug:"visual-guide",text:"The illustrated route"},...chapters.map(c=>({depth:2,slug:c.id,text:`${c.number} · ${c.title}`})),{depth:2,slug:"rectified-flow-lab",text:"Interactive rectified flow lab"},{depth:2,slug:"full-paper-notes",text:"Complete paper explanation"}] : headings),...(isDiffAtlas ? [{depth:2,slug:'diffatlas-lab',text:'Noise-matching lab'}] : []),...(isFlux ? [{depth:2,slug:'flow-explorer',text:'Explore the flow'}] : []),...(cards.length ? [{depth:2,slug:'study-cards',text:'Study cards'}] : [])]} /></aside></div>
</BaseLayout>
