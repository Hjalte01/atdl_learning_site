---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopicList from "../components/TopicList.astro";
import { getTopics } from "../lib/topics";
const topics=await getTopics();
---
<BaseLayout description="Understand advanced deep learning through illustrated paper guides, interactive experiments, and recall practice.">
<main class="learning-home">
<section class="home-intro page-shell"><p class="eyebrow">Advanced topics in deep learning · your study atlas</p><h1>Make the hard parts<br /><em>make sense.</em></h1><p class="lede">Pictures to build intuition. Experiments to test it.<br />Paper-by-paper explanations you can come back to.</p></section>
<section class="page-shell featured-lesson" aria-labelledby="featured-title">
 <div class="featured-topline"><span class="eyebrow">Featured visual guide · Topic 02 / Paper 05</span><span class="lesson-badge">6 illustrated chapters + a flow lab</span></div>
 <a class="featured-art" href="/papers/flux-kontext" aria-label="Open the illustrated FLUX.1 Kontext guide"><img src="/figures/flux/editing-context.png" alt="A bicycle changes from red to blue, then moves to a mountain setting while keeping its recognizable design." width="1916" height="821" fetchpriority="high" /></a>
 <div class="featured-copy"><div><h2 id="featured-title">FLUX.1 Kontext</h2><p>Change the scene. Keep the subject.<br />See how image context guides a generative flow.</p></div><div class="featured-actions"><a class="button primary" href="/papers/flux-kontext">Explore the visual guide →</a><a class="text-link" href="/papers/flux-kontext#rectified-flow-lab">Struggling with rectified flow? Start here ↗</a></div></div>
 <p class="art-note">Illustrative example · not a FLUX model result</p>
</section>
<section class="page-shell learning-path" aria-label="Three ways to learn">
 <a href="/papers/flux-kontext#visual-guide"><span>01 / SEE</span><h3>Build a mental picture.</h3><p>Six illustrations unpack the reference, latent space, flow, and attention.</p></a>
 <a href="/papers/flux-kontext#rectified-flow-lab"><span>02 / TRY</span><h3>Move through the math.</h3><p>Mix target and noise. Average arrows. Follow a velocity field.</p></a>
 <a href="/study"><span>03 / RECALL</span><h3>Explain it without looking.</h3><p>Check the key distinctions with study cards and immediate explanations.</p></a>
</section>
<section class="page-shell overview-section"><div class="section-heading"><div><p class="eyebrow">Course map</p><h2>Six topics. A growing understanding.</h2></div><span class="coverage-note">Flux explained · other papers queued</span></div><TopicList {topics} /></section>
</main>
</BaseLayout>
<style>
.home-intro{padding-top:5rem;padding-bottom:2.5rem}.home-intro h1{font-size:clamp(2.7rem,5.5vw,5.8rem);line-height:1.04;max-width:18ch;margin:1.4rem 0}.home-intro h1 em{font-family:var(--serif);color:var(--accent);font-weight:400}.home-intro .lede{font-size:1.2rem;max-width:60ch}.featured-lesson{background:var(--surface);border:1px solid var(--border);border-radius:22px;overflow:hidden;padding:0;box-shadow:var(--shadow)}.featured-topline{display:flex;justify-content:space-between;gap:1rem;padding:1.2rem 1.7rem;align-items:center}.featured-topline .eyebrow{margin:0}.lesson-badge{font-size:.7rem;border-radius:20px;background:var(--accent-soft);color:var(--accent);padding:.4rem .8rem}.featured-art{display:block;background:#f5f0e5}.featured-art img{display:block;width:100%;height:auto;max-height:460px;object-fit:contain}.featured-copy{padding:1.7rem 2rem .6rem;display:flex;align-items:center;gap:2rem;justify-content:space-between}.featured-copy h2{font-size:2.5rem;margin:0 0 .5rem}.featured-copy p{font:1.1rem/1.6 var(--serif);color:var(--muted);margin:0}.featured-actions{display:flex;flex-direction:column;gap:1rem;align-items:flex-start}.featured-actions .text-link{font-size:.8rem}.art-note{font-size:.68rem;color:var(--muted);padding:0 2rem 1rem}.learning-path{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem;margin-bottom:4rem}.learning-path a{text-decoration:none;border:1px solid var(--border);background:var(--surface-soft);border-radius:14px;padding:1.5rem;transition:transform .2s,border-color .2s}.learning-path a:hover{transform:translateY(-3px);border-color:var(--accent)}.learning-path span{font:.65rem var(--mono);letter-spacing:.12em;color:var(--accent)}.learning-path h3{font-size:1.15rem;margin:1rem 0 .5rem}.learning-path p{font-size:.88rem;color:var(--muted);margin:0}.coverage-note{font-size:.75rem;color:var(--muted)}
@media(max-width:700px){.home-intro{padding-top:3rem}.featured-topline{flex-wrap:wrap;padding:1rem}.featured-copy{flex-direction:column;align-items:start;padding:1.3rem}.featured-copy h2{font-size:2rem}.art-note{padding:0 1.3rem .8rem}.learning-path{grid-template-columns:1fr}.featured-lesson{width:calc(100% - 2rem)}.lesson-badge{font-size:.62rem}}
@media(prefers-reduced-motion:reduce){.learning-path a{transition:none}.learning-path a:hover{transform:none}}
</style>
