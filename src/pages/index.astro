---
import { withBase } from "../lib/url";
import BaseLayout from "../layouts/BaseLayout.astro";
import TopicList from "../components/TopicList.astro";
import { getTopics } from "../lib/topics";
import { getMaterialsWithProgress, materialCatalog } from "../lib/materials";
const topics = await getTopics();
const papers = (await getMaterialsWithProgress()).filter(m => m.kind === 'paper');
const ready = papers.filter(m => m.ready).length;
---
<BaseLayout description="Browse deep learning papers by topic, read available guides, and see which guides are still missing.">
  <main class="page-shell library-home">
    <header class="page-intro">
      <p class="eyebrow">Advanced topics in deep learning</p>
      <h1>Your papers.<br />Your learning library.</h1>
      <p class="lede">Find a paper, open its learning guide, and see what is still to come. Every supplied reading has a place here.</p>
      <div class="home-actions"><a class="button primary" href={withBase('/materials?kind=paper')}>Browse papers →</a><a href={withBase('/study')}>Practice with study cards →</a></div>
    </header>
    <nav class="progress-grid" aria-label="Paper guide progress">
      <a href={withBase('/materials?kind=paper')}><strong>{papers.length}</strong><span>Supplied papers</span></a>
      <a href={withBase('/materials?kind=paper&status=ready')}><strong>{ready}</strong><span>Guides ready to read →</span></a>
      <a href={withBase('/materials?kind=paper&status=missing')}><strong>{papers.length - ready}</strong><span>Guides missing →</span></a>
    </nav>
    <p class="coverage-note">Guide availability, not your personal reading progress.{!materialCatalog.inventoryComplete && ' The source inventory is incomplete; counts cover imported papers only.'}</p>
    <section class="overview-section" aria-labelledby="topic-heading">
      <div class="section-heading"><div><p class="eyebrow">Browse by topic</p><h2 id="topic-heading">Find your next reading</h2></div><a href={withBase('/materials')}>All PDFs &amp; reading types →</a></div>
      <TopicList {topics} />
    </section>
  </main>
</BaseLayout>
<style>
.library-home{padding-top:3rem;padding-bottom:4rem}.page-intro h1{font-size:clamp(2.4rem,5vw,4.5rem);line-height:1.1}.home-actions{display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap;margin:1.5rem 0 2rem}.progress-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.progress-grid a{display:grid;gap:.5rem;padding:1.5rem;background:var(--surface);border:1px solid var(--border);border-radius:14px;text-decoration:none}.progress-grid a:hover{border-color:var(--accent)}.progress-grid strong{font-size:2.5rem;color:var(--accent)}.progress-grid span{font-size:.9rem}.coverage-note{font-size:.8rem;color:var(--muted);margin:1rem 0 2.5rem}@media(max-width:600px){.progress-grid{grid-template-columns:1fr}.progress-grid a{display:flex;align-items:center;gap:1rem;padding:1rem}.progress-grid strong{font-size:1.8rem}}
</style>
