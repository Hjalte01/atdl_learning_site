---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <main class="page-shell not-found">
    <p class="eyebrow">404</p>
    <h1>This page is not in the research map.</h1>
    <p class="lede">The page may have moved, or the learning material has not been created yet.</p>
    <a class="button primary" href="/topics">Browse topics</a>
  </main>
</BaseLayout>
